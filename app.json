{
  "expo": {
    "name": "Soundmap",
    "slug": "soundmap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "soundmap",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.skylive.soundmap",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Soundmap measures how loud it is around you. Audio is processed on your device and never recorded or stored."
      }
    },
    "android": {
      "package": "com.skylive.soundmap",
      "adaptiveIcon": {
        "backgroundColor": "#4F7360",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F0E8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 100,
          "dark": {
            "backgroundColor": "#111412"
          }
        }
      ],
      "./plugins/with-ios-scene-lifecycle",
      "@maplibre/maplibre-react-native",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Soundmap uses your location when you add a measurement to the map or plan a walk from where you are. A measurement is rounded to a small area around you, and a walk is planned on your phone. Your exact position is never stored or sent."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "7e29253a-43c9-4b12-9f90-d353b8d4550d"
      }
    },
    "owner": "stivenkn"
  }
}
